{
  "name": "@oshi-connect/ui",
  "version": "0.1.0",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "default": "./dist/editor/index.js"
    }
  },
  "peerDependenciesMeta": {
    "fabric": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "pnpm --filter @oshi-connect/ui-playground dev",
    "build": "svelte-kit sync && svelte-package && cp src/lib/theme.css dist/theme.css",
    "package": "pnpm build",
    "test": "vitest run",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@lucide/svelte": "^1.3.0",
    "fabric": "^5.3.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@types/fabric": "^5.3.9",
    "fabric": "^5.3.0",
    "@eslint/js": "^9.16.0",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/kit": "^2.15.0",
    "@sveltejs/package": "^2.4.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/svelte": "^5.2.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.16.0",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^15.14.0",
    "happy-dom": "^20.8.9",
    "svelte": "^5.0.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "@lucide/svelte": "^1.3.0"
  },
  "packageManager": "pnpm@9.15.0"
}
